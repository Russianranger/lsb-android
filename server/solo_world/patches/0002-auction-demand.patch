 CDataLoader::~CDataLoader()
 {
+}
+
+// Price History is requested for one item and one lot size. Only the managed
+// catalogue can supply it, and every worker shares the same finite period budget.
+auto CDataLoader::TrySupplySoloAHItem(uint16 itemId, bool stack) const -> bool
+{
+    bool stocked = false;
+    const bool committed = db::transaction([&]()
+    {
+        const auto state = db::preparedStmt("SELECT demand_left FROM lsb_solo_auction_state WHERE id = 1 FOR UPDATE");
+        if (!state || !state->next() || state->get<uint8>("demand_left") == 0)
+        {
+            return;
+        }
+
+        const auto result = db::preparedStmt("INSERT INTO auction_house (itemid, stack, seller, seller_name, date, price) "
+                                             "SELECT b.itemid, ?, 0, 'LSB Provisioner', 4294967295, "
+                                             "GREATEST(b.BaseSell + 1, o.ask) * IF(?, b.stackSize, 1) "
+                                             "FROM lsb_solo_auction_offers o JOIN item_basic b ON b.itemid = o.itemid "
+                                             "WHERE o.itemid = ? AND b.aH > 0 AND (b.flags & 49216) = 0 AND (? = 0 OR b.stackSize > 1) "
+                                             "AND NOT EXISTS (SELECT 1 FROM auction_house a WHERE a.itemid = b.itemid "
+                                             "AND a.stack = ? AND a.buyer_name IS NULL AND a.sale = 0)",
+                                             stack, stack, itemId, stack, stack);
+        if (result && result->rowsAffected() > 0)
+        {
+            if (!db::preparedStmt("UPDATE lsb_solo_auction_state SET demand_left = demand_left - 1 WHERE id = 1"))
+            {
+                throw std::runtime_error("Could not record offline auction supply");
+            }
+            stocked = true;
+        }
+    });
+    return committed && stocked;
 }
 
